HOST=0.0.0.0
PORT=8000

# SQLite (default for testing)
DATABASE_URL=sqlite+aiosqlite:///scores_server.db
# PostgreSQL (for production)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcsu_ap

OSU_CLIENT_ID=your_client_id
OSU_CLIENT_SECRET=your_client_secret
OSU_REDIRECT_URI=https://ins4anya.fun/auth/callback

JWT_SECRET=generate-a-random-secret-here

SITE_URL=https://ins4anya.fun

# Daily challenge (bingo of 5 maps)
DAILY_CHALLENGE_ENABLED=true
DAILY_CHALLENGE_MAPS=5
DAILY_CHALLENGE_PER_MAP_BONUS=200
DAILY_CHALLENGE_BINGO_BONUS=500
DAILY_CHALLENGE_MIN_STARS=4.0
DAILY_CHALLENGE_MAX_STARS=7.0
DAILY_CHALLENGE_MAX_LENGTH=600
